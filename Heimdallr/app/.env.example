# Neon PostgreSQL (serverless) — https://neon.tech
# 예: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT 서명 비밀 (충분히 긴 랜덤 문자열)
JWT_SECRET=change-me-to-a-long-random-string

# LLM API 키 암호화용 마스터 키 (충분히 긴 랜덤 문자열)
MASTER_KEY=change-me-to-a-long-random-string
