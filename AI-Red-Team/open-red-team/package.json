{
  "name": "open-red-team",
  "version": "0.1.0",
  "description": "Model-agnostic offensive security skills middleware for DeepSeek, GLM, and open-weight models",
  "type": "module",
  "bin": {
    "ort": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -r src/dashboard/static dist/src/dashboard/static",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "fetch:skills": "tsx scripts/fetch-skills.ts",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t open-ai-red-team:latest .",
    "docker:up": "docker compose up -d ort",
    "docker:up:poc": "docker compose --profile poc up -d",
    "docker:up:prod": "docker compose --profile serving --profile auth --profile observability --profile monitoring up -d",
    "docker:down": "docker compose --profile serving --profile poc --profile auth --profile observability --profile monitoring down",
    "offline:export": "bash scripts/offline/export-images.sh",
    "offline:import": "bash scripts/offline/import-images.sh",
    "models:export": "bash scripts/offline/export-models.sh",
    "sbom:scan": "bash scripts/sbom/scan.sh",
    "sign:image": "bash scripts/sbom/sign.sh"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
