{
  "name": "open-ai-red-team",
  "version": "0.6.0",
  "description": "Model-agnostic offensive security skills middleware for DeepSeek, GLM, and open-weight models",
  "type": "module",
  "bin": {
    "ort": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "skills",
    "docs",
    "scripts",
    "assets",
    "README*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/dashboard/static dist/src/dashboard/static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "fetch:skills": "tsx scripts/fetch-skills.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "docker:build": "docker build -t open-ai-red-team:latest .",
    "docker:up": "docker compose up -d ort",
    "docker:up:poc": "docker compose --profile poc up -d",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.infra.yml --profile serving --profile auth --profile observability --profile monitoring up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.infra.yml --profile serving --profile poc --profile cli --profile auth --profile observability --profile monitoring down",
    "offline:export": "bash scripts/offline/export-images.sh",
    "offline:import": "bash scripts/offline/import-images.sh",
    "models:export": "bash scripts/offline/export-models.sh",
    "sbom:scan": "bash scripts/sbom/scan.sh",
    "sign:image": "bash scripts/sbom/sign.sh",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "langfuse": "^3.39.2",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
