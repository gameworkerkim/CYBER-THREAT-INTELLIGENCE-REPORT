# ---- Open AI Red Team configuration ----

# Default provider: deepseek | glm | openweight
ORT_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- GLM (Zhipu BigModel) ----
GLM_API_KEY=xxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# ---- Open-weight (Ollama / vLLM / LM Studio / llama.cpp) ----
OPENWEIGHT_BASE_URL=http://localhost:11434/v1
OPENWEIGHT_MODEL=qwen2.5:32b
OPENWEIGHT_API_KEY=ollama

# ---- Skill engine ----
# Directory containing ported skills
ORT_SKILLS_DIR=./skills
# Auto-load skills by trigger matching: on | off
ORT_AUTO_LOAD=on
# Max skills to auto-load per turn
ORT_MAX_SKILLS=3
# Include skill descriptions in system prompt (progressive disclosure)
ORT_INCLUDE_INDEX=on

# ---- Web dashboard ----
# Listen port for `ort dashboard`
ORT_DASHBOARD_PORT=8081
# Bearer token required by the dashboard API (empty = no auth, dev only)
ORT_DASHBOARD_TOKEN=
# OIDC (Keycloak) verification for the dashboard API — overrides ORT_DASHBOARD_TOKEN when set
# ORT_OIDC_ISSUER=http://keycloak:8080/realms/open-red-team
# ORT_OIDC_AUDIENCE=ort-dashboard
# JSONL audit log path for dashboard interactions (compliance)
ORT_AUDIT_LOG=./logs/audit.jsonl

# ---- Engagement scope & safety guardrails ----
# Declared engagement scope (injected into the system prompt and audited)
ORT_SCOPE=
# Comma-separated in-scope domains/IPs; out-of-scope targets are flagged
ORT_SCOPE_DOMAINS=
# Operator identity recorded in audit/traces
ORT_OPERATOR=

# ---- Context budget (token overflow protection) ----
# Model context limit (defaults: deepseek 64000, glm 128000, openweight 32000)
ORT_MAX_CONTEXT=
# Max tokens injected per skill body (defaults: deepseek 16000, glm 24000, openweight 8000)
ORT_SKILL_BUDGET=
# Tokens reserved for the response
ORT_RESERVE_TOKENS=4096

# ---- LLM observability (LangFuse) ----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=http://localhost:3000
