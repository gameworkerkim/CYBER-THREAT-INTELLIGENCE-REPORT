# ---- Open AI Red Team configuration ----

# Default provider: deepseek | glm | openweight
ORT_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- GLM (Zhipu BigModel) ----
GLM_API_KEY=xxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# ---- Open-weight (Ollama / vLLM / LM Studio / llama.cpp) ----
OPENWEIGHT_BASE_URL=http://localhost:11434/v1
OPENWEIGHT_MODEL=qwen2.5:32b
OPENWEIGHT_API_KEY=ollama

# ---- Skill engine ----
# Directory containing ported skills
ORT_SKILLS_DIR=./skills
# Auto-load skills by trigger matching: on | off
ORT_AUTO_LOAD=on
# Max skills to auto-load per turn
ORT_MAX_SKILLS=3
# Include skill descriptions in system prompt (progressive disclosure)
ORT_INCLUDE_INDEX=on

# ---- Web dashboard ----
# Listen port for `ort dashboard`
ORT_DASHBOARD_PORT=8081
# SQLite path for local accounts & runtime settings (default ./data/ort.db)
ORT_DB_PATH=./data/ort.db
# HMAC signing secret for login tokens (auto-generated and persisted in the DB when empty)
# ORT_AUTH_SECRET=change-me
# Set to 1 to disable local accounts (OIDC/static-token only)
# ORT_DISABLE_LOCAL_AUTH=1
# Bearer token for the dashboard API (alternative to local accounts)
ORT_DASHBOARD_TOKEN=
# Metrics endpoint token (falls back to the dashboard auth above when empty)
ORT_METRICS_TOKEN=
# Allow the dashboard to start without any authentication (local lab only)
# ORT_ALLOW_ANONYMOUS=1
# OIDC (Keycloak) verification for the dashboard API — overrides ORT_DASHBOARD_TOKEN when set
# ORT_OIDC_ISSUER=http://keycloak:8080/realms/open-red-team
# ORT_OIDC_AUDIENCE=ort-dashboard
# JSONL audit log path for dashboard interactions (compliance)
ORT_AUDIT_LOG=./logs/audit.jsonl
# Fail the request when the audit log cannot be written
# ORT_AUDIT_REQUIRED=1
# Rotate the audit log when it exceeds this size (default 10 MiB, single rotation)
ORT_AUDIT_MAX_BYTES=10485760
# Login rate limit: max failures per username+IP before a lockout
ORT_LOGIN_MAX_ATTEMPTS=5
# Lockout duration in milliseconds
ORT_LOGIN_LOCK_MS=300000

# ---- Engagement scope & safety guardrails ----
# Declared engagement scope (required unless ORT_SCOPE_MODE=open).
# Out-of-scope hosts/IPs are refused BEFORE any model call.
ORT_SCOPE=
# Comma-separated in-scope domains/IPs
ORT_SCOPE_DOMAINS=
# Operator identity recorded in audit/traces
ORT_OPERATOR=
# Set to "open" to run without a declared scope (local lab only)
# ORT_SCOPE_MODE=open

# ---- Context budget (token overflow protection) ----
# Model context limit (defaults: deepseek 64000, glm 128000, openweight 32000)
ORT_MAX_CONTEXT=
# Max tokens injected per skill body (defaults: deepseek 16000, glm 24000, openweight 8000)
ORT_SKILL_BUDGET=
# Tokens reserved for the response
ORT_RESERVE_TOKENS=4096

# ---- LLM observability (LangFuse) ----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=http://localhost:3000
